<group name="tfm,wazuh,windows,">

  <!-- P1 - TEC-009 Exfiltración HTTP/ZIP por PowerShell 4104 -->
  <rule id="110201" level="15">
    <if_group>windows</if_group>
    <field name="win.system.eventID">4104</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(Invoke-WebRequest|Invoke-RestMethod|iwr|curl|wget|WebClient|UploadFile)</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(POST|upload|ReceiverUrl|InFile|\.zip)</field>
    <description>TFM P1 TEC-009 posible exfiltracion HTTP ZIP mediante PowerShell</description>
    <mitre>
      <id>T1048.003</id>
      <id>T1560.001</id>
    </mitre>
  </rule>

  <!-- P1 - TEC-008 Borrado masivo/destructivo -->
  <rule id="110202" level="14">
    <if_group>windows</if_group>
    <field name="win.system.eventID">4104</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(Remove-Item|del|erase|rmdir)</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(-Recurse|-Force)</field>
    <description>TFM P1 TEC-008 borrado destructivo mediante PowerShell</description>
    <mitre>
      <id>T1485</id>
    </mitre>
  </rule>

  <!-- P1 - TEC-007 Cifrado tipo ransomware -->
  <rule id="110203" level="15">
    <if_group>windows</if_group>
    <field name="win.system.eventID">4104</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(System.Security.Cryptography|Aes|CryptoStream|CreateEncryptor|\.aes)</field>
    <description>TFM P1 TEC-007 comportamiento de cifrado mediante PowerShell</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

  <!-- P2 - PowerShell sospechoso -->
  <rule id="110301" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">4104</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)(ExecutionPolicy Bypass|-EncodedCommand|FromBase64String|Invoke-Expression|IEX|DownloadString)</field>
    <description>TFM P2 PowerShell sospechoso detectado en ScriptBlock 4104</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- P3 - Persistencia Run Key por Sysmon -->
  <rule id="110401" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">1</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(reg add|CurrentVersion\\Run|CurrentVersion\\RunOnce)</field>
    <description>TFM P3 posible persistencia Run Key mediante Sysmon</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- P3 - Creación de servicio -->
  <rule id="110402" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">7045</field>
    <description>TFM P3 instalacion de servicio Windows</description>
    <mitre>
      <id>T1569.002</id>
    </mitre>
  </rule>

  <!-- P4 - PowerShell básico sospechoso por Sysmon -->
  <rule id="110501" level="5">
    <if_group>windows</if_group>
    <field name="win.system.eventID">1</field>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell.exe|pwsh.exe</field>
    <description>TFM P4 ejecucion de PowerShell observada por Sysmon</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

</group>
